# The directory Mix uses for compiled artifacts.
/_build/

# Dependency sources fetched by Mix.
/deps/

# Zigler's generated copy of an external Zig module.
/lib/**/.Elixir.*.zig

# Generated documentation.
/doc/

# Files generated by `mix test --cover`.
/cover/

# Crash dumps produced by the Erlang VM.
erl_crash.dump

# Archives and packages generated by `mix archive.build` or `mix hex.build`.
*.ez
/simd_json-*.tar

# Temporary files created by editors and operating systems.
*~
.DS_Store
